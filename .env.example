# Cloudflare Access (protects /api/compile)
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-access-app-audience
ENFORCE_ACCESS=0
BYPASS_ACCESS=0

# GitHub workflow dispatch (called by /api/compile)
GITHUB_OWNER=YourOrgOrUser
GITHUB_REPO=your-repo
GITHUB_WORKFLOW_ID=compile-post.yml
GITHUB_REF=main
GITHUB_DISPATCH_TOKEN=ghp_...

