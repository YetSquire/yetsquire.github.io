---
import Layout from "../layouts/Layout.astro";
import { TEXT_COLORS } from "../config/site";

//todo- optimize typeloop
//todo- make a most viewed posts suggestion! along with the other two suggestions

// Find latest post by inspecting the directory structure under src/content/posts
// We pick the highest year directory, then highest month directory inside it,
// then choose the newest post by frontmatter `date` inside that folder.
const modules = import.meta.glob("../content/posts/**/*.{md,mdx}", {
	eager: true,
}) as Record<string, any>;

type PostMeta = {
	id: string;
	pathname: string;
	title: string;
	date: string;
};

function getLatestByTag(tag: string): PostMeta | null {
	const allPosts = Object.entries(modules).map(([path, mod]) => {
		const fm = mod.frontmatter || {};
		const parts = path.split("/");
		const filename = parts[parts.length - 1];

		const year = Number(parts[parts.length - 3]) || 0;
		const month = Number(parts[parts.length - 2]) || 0;
		const id = fm.id || filename.replace(/\.(md|mdx)$/, "");
		const pathname = `/post/${id}`;

		return {
			id,
			pathname,
			fm,
			path,
			year,
			month,
			tags: fm.tags || [],
		};
	});

	// 1. Filter by tag
	const taggedPosts = allPosts.filter(
		(p) => Array.isArray(p.tags) && p.tags.includes(tag),
	);

	if (taggedPosts.length === 0) return null;

	// 2. Latest year
	const latestYear = Math.max(...taggedPosts.map((p) => p.year));
	const inYear = taggedPosts.filter((p) => p.year === latestYear);

	// 3. Latest month
	const latestMonth = Math.max(...inYear.map((p) => p.month));
	const inMonth = inYear.filter((p) => p.month === latestMonth);

	// 4. Sort by frontmatter date
	inMonth.sort(
		(a, b) =>
			new Date(b.fm.date || "1970-01-01").getTime() -
			new Date(a.fm.date || "1970-01-01").getTime(),
	);

	const latest = inMonth[0];
	if (!latest) return null;

	return {
		id: latest.id,
		pathname: latest.pathname,
		title: latest.fm.title || latest.id,
		date: latest.fm.date || "",
	};
}

const latestBlog = getLatestByTag("blog");
const latestProject = getLatestByTag("project");
---

<Layout title="Home | My Blog">
	<div class="hero">
		<section class="introduction">
			<div
				class="hero-image-swap"
				tabindex="0"
				role="img"
			></div>

			<div class="intro-text">
				<p class="typed-subtitle">
					<span id="typed-text"></span>
					<span class="cursor">|</span>
				</p>
				<p>
					My name is Andy, developer, history nerd, and aspiring
					human.
					<br /><br />
					I like building <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Project};`}
						href="/posts?tags=projects">wearable tech</a
					> and thinking about the <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Blog};`}
						href="/posts?tags=blog">past</a
					>.
					<br /><br />
					<!-- You can read about that in my <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Post};`}
						href="/posts">posts</a
					>.
					<br /><br /> -->
					To learn more about myself, see the <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.About};`}
						href="/about">About</a
					> page.
				</p>
			</div>
		</section>
	</div>

	<!-- <section class="featured">
		<h2>Featured</h2>

		<div class="featured-grid">
			<a
				class="feature-card"
				href={latestBlog ? latestBlog.pathname : "/posts"}
			>
				<h3>Latest Blog</h3>
				<p class="muted">
					{latestBlog ? latestBlog.title : "No blog yet"}
				</p>
			</a>

			<a
				class="feature-card"
				href={latestProject ? latestProject.pathname : "/posts"}
			>
				<h3>Latest Project</h3>
				<p class="muted">
					{latestProject ? latestProject.title : "No projects yet"}
				</p>
			</a>
		</div>
	</section> -->
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		align-items: center;
		padding: 3rem 0;
		border-bottom: 2px solid #30363d;
		margin-bottom: 2rem;
	}

	.card-container {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.introduction {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 4rem;
	}

	.intro-text {
		padding-top: 1.5rem;
	}

	.intro-text > p:not(.typed-subtitle) {
		font-size: 1.15rem;
		color: #8b949e;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		text-align: left;
		justify-content: center;
	}

	.typed-subtitle {
		font-size: 2.5rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #000000;
		text-align: center;
		margin-bottom: 2rem;
		font-weight: 700;
	}

	.cursor {
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.cta-button {
		display: inline-block;
		background-color: #58a6ff;
		color: black;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.2s;
	}

	.cta-button:hover {
		background-color: #79c0ff;
	}

	.featured {
		text-align: center;
		margin: 0 auto;
	}

	.featured h2 {
		margin-bottom: 1rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.hero-image-swap {
		width: 400px;
		height: 500px;
		border-radius: 8px;
		background-image: url("/images/babel.jpg");
		background-size: cover;
		background-position: center;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
		transition:
			background-image 600ms ease,
			transform 800ms ease,
			box-shadow 800ms ease;
		cursor: pointer;
	}

	.hero-image-swap:hover,
	.hero-image-swap:focus-visible {
		background-image: url("/images/test.png");
		transform: translateY(-4px);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
	}

	@media (max-width: 780px) {
		.introduction {
			flex-direction: column;
			gap: 2rem;
		}

		.hero-image-swap {
			width: 220px;
			height: 300px;
		}
	}

	.feature-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid #30363d;
		border-radius: 4px;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s;
		background-color: #0d1117;
	}

	.feature-card:hover {
		border-color: #58a6ff;
		box-shadow: 0 0 12px rgba(88, 166, 255, 0.2);
	}

	.feature-card h3 {
		margin-bottom: 0.5rem;
		color: #f0f6fc;
	}

	.muted {
		color: #8b949e;
		font-size: 0.95rem;
	}
</style>

<script is:inline>
	document.addEventListener("astro:page-load", () => {
		initHero();
	});

	function initHero() {
		// Typed text
		const words = [
			"Hello",
			"👋😄",
			"你好",
			"こんにちは",
			"안녕하세요",
			"Bonjour",
			"Hola",
			"Ciao",
			"Saluton",
			"9jR°`N",
			"nuqneH",
			// "Congrats for waiting till the end",
			// "You found the easter egg!",
			// "If you email me, mention Pomegranates",
			// "Bye!",
			// "Help",
			// "Help me",
			// "pLeASe",
			// "itS cOmiNG",
			// "iM slIPPiNg",
			// "PLEA-"
		];

		const el = document.getElementById("typed-text");
		if (!el) return;

		let wordIndex = 0;
		let charIndex = 0;
		let deleting = false;

		function typeLoop() {
			const word = words[wordIndex];

			if (!deleting) {
				const chars = [...word];
				el.textContent = chars.slice(0, charIndex++).join("");
				if (charIndex === word.length) {
					setTimeout(() => {
						deleting = true;
					}, 1200);
				}
			} else {
				const chars = [...word];
				el.textContent = chars.slice(0, charIndex--).join("");
				if (charIndex <= 0) {
					deleting = false;
					wordIndex = (wordIndex + 1) % words.length;
					charIndex = 0;
				}
			}

			setTimeout(typeLoop, deleting ? 60 : 150);
		}

		typeLoop();
	}
</script>
