---
import Layout from "../layouts/Layout.astro";
import { TEXT_COLORS } from "../config/site";
import PostCard from "../components/PostCard.astro";
import initPostsCode from "../scripts/init_posts.js?raw";
import slugify from "slugify";

//todo- optimize typeloop
//todo- make a most viewed posts suggestion! along with the other two suggestions

const modules = import.meta.glob("../content/posts/**/*.{md,mdx}", {
	eager: true,
}) as Record<string, any>;

type Featured = {
	title: string;
	pathname: string;
};

const decodeHtmlEntities = (value: string): string => {
	return String(value || "")
		.replace(/&nbsp;/g, " ")
		.replace(/&amp;/g, "&")
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'")
		.replace(/&lt;/g, "<")
		.replace(/&gt;/g, ">")
		.replace(/&rsquo;|&lsquo;/g, "'")
		.replace(/&rdquo;|&ldquo;/g, '"');
};

const stripHtml = (value: string): string =>
	String(value || "").replace(/<[^>]*>/g, "");

const normalizeWhitespace = (value: string): string =>
	String(value || "")
		.replace(/\s+/g, " ")
		.trim();

const extractFirstSegment = async (
	mod: any,
	title: string,
): Promise<string> => {
	let source = "";

	try {
		if (typeof mod?.compiledContent === "function") {
			source = await mod.compiledContent();
		} else if (typeof mod?.rawContent === "function") {
			source = mod.rawContent();
		}
	} catch {
		// ignore
	}

	if (!source && typeof mod?.rawContent === "function") {
		try {
			source = mod.rawContent();
		} catch {
			// ignore
		}
	}

	source = String(source || "").replace(/^---[\s\S]*?---\s*/m, "");
	if (!source) return "";

	// Prefer the first meaningful <p> when content is HTML-exported.
	const titleLower = String(title || "").trim().toLowerCase();
	const pMatches = Array.from(source.matchAll(/<p\b[^>]*>([\s\S]*?)<\/p>/gi));
	for (const match of pMatches) {
		const raw = match?.[1] || "";
		const text = normalizeWhitespace(decodeHtmlEntities(stripHtml(raw)));
		if (!text) continue;
		if (titleLower && text.toLowerCase() === titleLower) continue;
		if (/^\d{1,2}\/\d{1,2}\/\d{2,4}$/.test(text)) continue;
		if (/^\d{4}-\d{2}-\d{2}$/.test(text)) continue;
		if (text.length < 25 && !/[.!?]/.test(text)) continue;
		return text;
	}

	// Markdown fallback: first non-empty paragraph-ish chunk.
	const cleaned = source
		.replace(/<style\b[\s\S]*?<\/style>/gi, "")
		.replace(/```[\s\S]*?```/g, "")
		.trim();

	const chunks = cleaned
		.split(/\n\s*\n/)
		.map((c) => normalizeWhitespace(decodeHtmlEntities(stripHtml(c))))
		.filter(Boolean);

	for (const chunk of chunks) {
		if (titleLower && chunk.toLowerCase() === titleLower) continue;
		if (chunk.length < 25 && !/[.!?]/.test(chunk)) continue;
		return chunk;
	}

	return "";
};

const parseDateOnlyAsLocalDate = (value: string): Date => {
	const m = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
	if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
	return new Date(value);
};

const posts = await Promise.all(Object.entries(modules).map(async ([path, mod]) => {
	const fm = mod.frontmatter || {};
	const pathEnd = path.split("/");
	const id = fm.id || pathEnd[pathEnd.length - 1].replace(/\.(md|mdx)$/, "");

	const routeImagePath = (imagePath: string): string => {
		if (!imagePath) return "";
		if (imagePath.startsWith("/") || imagePath.startsWith("http"))
			return imagePath;
		return `/images/posts/${id}/${imagePath}`;
	};

	const coverSource = fm.cover || fm.image || "";
	const cover = coverSource ? routeImagePath(coverSource) : "";

	const fmImages = Array.isArray(fm.images)
		? fm.images.slice()
		: fm.images
			? [fm.images]
			: [];
	if (fm.image && !fmImages.includes(fm.image)) fmImages.unshift(fm.image);
	const images = fmImages
		.map((img: string) => routeImagePath(img))
		.filter(Boolean);

	const fmVideos = Array.isArray(fm.videos)
		? fm.videos.slice()
		: fm.videos
			? [fm.videos]
			: [];
	if (fm.video && !fmVideos.includes(fm.video)) fmVideos.unshift(fm.video);
	const videos = fmVideos.filter(Boolean);

	return {
		id,
		title: fm.title || id,
		description: fm.description || "",
		excerpt: await extractFirstSegment(mod, fm.title || id),
		date: fm.date || "1970-01-01",
		tags: fm.tags || [],
		cover,
		images,
		videos,
		pathname: `/post/${id}`,
	};
}));

function getFeaturedByTitle(title: string): Featured | null {
	const t = String(title || "").trim();
	if (!t) return null;

	const match = posts.find((p) => p.title === t);
	if (match) return { title: match.title, pathname: match.pathname };

	const slug = slugify(t, { lower: true, strict: true, trim: true });
	if (!slug) return null;
	return { title: t, pathname: `/post/${slug}` };
}

// Hardcode these by post title (exact match preferred).
const FEATURED_A_TITLE = "About This Website";
const FEATURED_B_TITLE = "";

const featuredA = getFeaturedByTitle(FEATURED_A_TITLE);
const featuredB = getFeaturedByTitle(FEATURED_B_TITLE);

const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort();
const sortedPosts = posts.sort(
	(a, b) =>
		parseDateOnlyAsLocalDate(b.date).getTime() -
		parseDateOnlyAsLocalDate(a.date).getTime(),
);
---

<Layout title="Home | My Blog">
	<script is:inline set:html={initPostsCode}></script>

	<div class="hero">
		<section class="introduction">
			<div class="hero-image-swap" tabindex="0" role="img"></div>

			<div class="intro-text">
				<p class="typed-subtitle">
					<span id="typed-text"></span>
					<span class="cursor">|</span>
				</p>
				<p>
					My name is Andy, XR developer, history nerd, and aspiring
					human.
					<br /><br />
					I like building <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Project};`}
						href="/"
						data-post-tag="Project">systems</a
					> and thinking about the <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Blog};`}
						href="/"
						data-post-tag="Thought">world</a
					>.
					<br /><br />
					You can scroll down, or learn <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.About};`}
						href="/about">about</a
					> me.
				</p>
			</div>
		</section>
	</div>

	<!-- <section class="featured">
		<h2>Featured</h2>

		<div class="featured-grid">
			<a class="feature-card" href={featuredA ? featuredA.pathname : "/"}>
				<p class="muted">
					{featuredA ? featuredA.title : "Set FEATURED_A_TITLE"}
				</p>
			</a>

			<a class="feature-card" href={featuredB ? featuredB.pathname : "/"}>
				<p class="muted">
					{featuredB ? featuredB.title : "Set FEATURED_B_TITLE"}
				</p>
			</a>
		</div>
	</section> -->

	<section class="posts-section" id="posts">
		<div class="filters">
			<h2>Filter by Tags:</h2>
			<div class="tag-buttons">
				<button
					id="tag-all"
					class="filter-tag active"
				>
					All
				</button>
				{
					allTags.map((tag) => (
						<button
							class="filter-tag"
							data-tag={tag}
						>
							{tag}
						</button>
					))
				}
			</div>
		</div>

		<div class="posts-count">
			<p>
				Showing {sortedPosts.length} post{sortedPosts.length !== 1 ? "s" : ""}
			</p>
		</div>

		<div class="posts-list" id="posts-list">
			{
				sortedPosts.length > 0 ? (
					sortedPosts.map((post) => <PostCard post={post} />)
				) : (
					<p class="no-posts">No posts found with the selected tags.</p>
				)
			}
		</div>
	</section>
</Layout>

	<style>
		.hero {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-height: 100vh;
			padding: clamp(2rem, 6vh, 4rem) 0 clamp(4rem, 16vh, 10rem) 0;
			gap: 2.5rem;
		}

	.card-container {
		display: flex;
		align-items: center;
		justify-content: center;
	}

		.introduction {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: 4rem;
			width: 100%;
		}

	.intro-text {
		padding-top: 1.5rem;
	}

	.intro-text > p:not(.typed-subtitle) {
		font-size: 1.15rem;
		color: #8b949e;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		text-align: left;
		justify-content: center;
	}

	.typed-subtitle {
		font-size: 2.5rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #000000;
		text-align: center;
		margin-bottom: 2rem;
		font-weight: 700;
	}

	.cursor {
		display: inline-block;
		opacity: 1;
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.cta-button {
		display: inline-block;
		background-color: #58a6ff;
		color: black;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.2s;
	}

	.cta-button:hover {
		background-color: #79c0ff;
	}

	.featured {
		text-align: center;
		margin: 0 auto;
	}

	.featured h2 {
		margin-bottom: 1rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	.hero-image-swap {
		width: 400px;
		height: 500px;
		border-radius: 8px;
		background-image: url("/images/babel.jpg");
		background-size: cover;
		background-position: center;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
		transition:
			background-image 600ms ease,
			transform 800ms ease,
			box-shadow 800ms ease;
		cursor: pointer;
	}

	.hero-image-swap:hover,
	.hero-image-swap:focus-visible {
		background-image: url("/images/test.png");
		transform: translateY(-4px);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
	}

	@media (max-width: 780px) {
		.introduction {
			flex-direction: column;
			gap: 2rem;
		}

		.hero-image-swap {
			width: 220px;
			height: 300px;
		}
	}

	.feature-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid #30363d;
		border-radius: 4px;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s;
		background-color: #0d1117;
	}

	.feature-card:hover {
		border-color: #58a6ff;
		box-shadow: 0 0 12px rgba(88, 166, 255, 0.2);
	}

	.feature-card h3 {
		margin-bottom: 0.5rem;
		color: #f0f6fc;
	}

	.muted {
		color: #8b949e;
		font-size: 0.95rem;
	}

	.posts-section {
		margin-top: 3rem;
	}

	.filters {
		padding: 0.5rem;
		border-radius: 4px;
		margin-bottom: 0.5rem;
	}

	.filters h2 {
		margin-bottom: 0.4rem;
		font-size: 1.1rem;
	}

	.tag-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.filter-tag {
		padding: 0.5rem 1rem;
		background-color: white;
		border: 2px solid #ddd;
		border-radius: 20px;
		color: #333;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9rem;
		font-family: inherit;
	}

	.filter-tag:hover {
		border-color: #0066cc;
		color: #0066cc;
	}

	.filter-tag.active {
		background-color: #0066cc;
		border-color: #0066cc;
		color: white;
	}

	.posts-count {
		margin: 0.5rem;
		margin-bottom: 2rem;
		color: #666;
		font-size: 0.95rem;
	}

	.no-posts {
		text-align: center;
		color: #999;
		padding: 2rem;
		font-style: italic;
	}
</style>

<script is:inline>
	document.addEventListener("astro:page-load", () => {
		initHero();
	});

	function initHero() {
		// Typed text
		const words = [
			"Hello",
			"👋😄",
			"你好",
			"こんにちは",
			"안녕하세요",
			"Bonjour",
			"Hola",
			"Ciao",
			"Saluton",
			"9jR°`N",
			"nuqneH",
			// "Congrats for waiting till the end",
			// "You found the easter egg!",
			// "If you email me, mention Pomegranates",
			// "Bye!",
			// "Help",
			// "Help me",
			// "pLeASe",
			// "itS cOmiNG",
			// "iM slIPPiNg",
			// "PLEA-"
		];

		const el = document.getElementById("typed-text");
		if (!el) return;

		const container =
			el.closest(".typed-subtitle") || el.parentElement || el;
		if (!container) return;
		if (container.dataset.typedInit === "1") return;
		container.dataset.typedInit = "1";

		let wordIndex = 0;
		let charIndex = 0;
		let deleting = false;
		let running = false;
		let timerId = null;

		const schedule = (ms) => {
			if (timerId) clearTimeout(timerId);
			timerId = setTimeout(tick, ms);
		};

		function tick() {
			if (!running) return;

			const word = String(words[wordIndex] || "");
			const chars = [...word];

			if (!deleting) {
				charIndex = Math.min(charIndex + 1, chars.length);
				el.textContent = chars.slice(0, charIndex).join("");
				if (charIndex >= chars.length) { //only the pivot back
					deleting = true;
					schedule(2000);
					return;
				}
				schedule(150);
				return;
			}

			charIndex = Math.max(charIndex - 1, 0);
			el.textContent = chars.slice(0, charIndex).join("");
			if (charIndex <= 0) {
				deleting = false;
				wordIndex = (wordIndex + 1) % words.length;
				schedule(1000);
				return;
			}
			schedule(150);
		}

		const start = () => {
			if (running) return;
			running = true;
			tick();
		};

		const stop = () => {
			running = false;
			if (timerId) clearTimeout(timerId);
			timerId = null;
		};

		container.addEventListener("mouseenter", start);
		container.addEventListener("mouseleave", stop);
	}
</script>
