---

import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';

const latestPost = posts.slice().sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())[0];

---

<Layout title="Home | My Blog">
	<div class="hero">
		<div class="hero-left">
			<div class="card-widget" tabindex="0" aria-label="Hero image cards">
				<div class="card card--back">
					<img src="/images/babel.jpg" alt="back" />
				</div>
				<div class="card card--front">
					<img src="/images/test.png" alt="front" />
				</div>
			</div>
		</div>

		<div class="hero-right">
			<p>
				Hi! My name is Andy, developer, history nerd, and aspiring human.
				<br><br>
				I like building wearable tech and thinking about the past and the future.
				<br><br>
				This is a repository for my thoughts and projects.
				They're all located under the 'posts' section, but I'd recommend
				looking at the featured posts below to get started.
				<br><br>
				To learn more about myself and this website, see the <a href="/about">About</a> page.
			</p>
		</div>
	</div>

	<section class="featured">
		<h2>Featured</h2>

		<div class="featured-grid">
			<a class="feature-card" href={latestPost ? `/post/${latestPost.id}` : '/posts'}>
				<h3>Latest Post</h3>
				<p class="muted">{latestPost ? latestPost.title : 'No posts yet'}</p>
			</a>

			<a class="feature-card" href="/posts?tags=blog">
				<h3>Blog Posts</h3>
				<p class="muted">View posts tagged "blog"</p>
			</a>

			<a class="feature-card" href="/posts?tags=projects">
				<h3>Projects</h3>
				<p class="muted">View posts tagged "projects"</p>
			</a>
		</div>
        
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
		padding: 3rem 0;
		border-bottom: 2px solid #e0e0e0;
		margin-bottom: 2rem;
	}

	.hero-left {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-image {
		width: 100%;
		max-width: 420px;
		height: auto;
		border-radius: 8px;
		object-fit: cover;
	}

	.hero-right p {
		font-size: 1.15rem;
		color: #666;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		text-align: left;
	}

	.cta-button {
		display: inline-block;
		background-color: #0066cc;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.2s;
	}

	.cta-button:hover {
		background-color: #0052a3;
	}

	.featured {
		text-align: center;
		margin: 0 auto;
	}

	.featured h2 {
		margin-bottom: 1rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	/* Card widget styles */
	.card-widget {
		position: relative;
		width: 400px;
		height: 500px;
		display: inline-block;
		cursor: pointer;
	}

	.card-widget .card {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 8px 20px rgba(0,0,0,0.12);
		transition: transform 300ms cubic-bezier(.2,.9,.2,1), box-shadow 300ms;
	}

	.card-widget img { width: 100%; height: 100%; object-fit: cover; display: block; }

	.card--back { transform: translate(12px, 8px) rotate(-6deg) skew(-4deg); z-index: 1; }
	.card--front { transform: translate(-8px, -6px) rotate(6deg) skew(4deg); z-index: 2; }

	.card-widget.is-swapped .card--back { transform: translate(-8px, -6px) rotate(6deg) skew(4deg); z-index: 2; }
	.card-widget.is-swapped .card--front { transform: translate(12px, 8px) rotate(-6deg) skew(-4deg); z-index: 1; }

	.card-widget:hover .card,
	.card-widget:focus .card,
	.card-widget.is-swapped .card { box-shadow: 0 14px 30px rgba(0,0,0,0.16); }

	@media (max-width: 780px) {
		.card-widget { width: 220px; height: 150px; }
	}

	.feature-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid #e0e0e0;
		border-radius: 4px;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s;
	}

	.feature-card:hover {
		border-color: #0066cc;
	}

	.feature-card h3 {
		margin-bottom: 0.5rem;
	}

	.muted {
		color: #666;
		font-size: 0.95rem;
	}
</style>

<script>
// Card widget interaction: swap on hover/focus, swap back on leave/blur
(() => {
	const widget = document.querySelector('.card-widget');
	if (!widget) return;

	const swap = () => widget.classList.toggle('is-swapped');

	// widget.addEventListener('mouseenter', swap);
	// widget.addEventListener('focus', swap);
	widget.addEventListener('click', swap);
})();
</script>
