---
import Layout from "../layouts/Layout.astro";
import { TEXT_COLORS } from "../../site";
import PostCard from "../components/PostCard.astro";
import initPostsCode from "../scripts/init_posts.js?raw";
import { extractExcerptFromHtml, loadGeneratedPosts } from "../lib/posts";
const postLinks = (await import("../content/post_links.json")).default as Record<string, string>;

const parseDateOnlyAsLocalDate = (value: string): Date => {
	const m = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
	if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
	return new Date(value);
};

const posts = loadGeneratedPosts(postLinks).map((post) => ({
	...post,
	excerpt: extractExcerptFromHtml(post.html, post.title),
}));

const manualPosts = [
	{
		id: "about-me",
		title: "About Me",
		description: "A quick overview of who I am and how to reach me.",
		excerpt: "A quick overview of who I am and how to reach me.",
		date: "2026-01-01",
		tags: ["Featured", "About", "Thought"],
		cover: "",
		images: [],
		videos: [],
		externalUrl: "",
		pathname: "/post/about-me",
	},
];


const allPosts = [
	...manualPosts.filter(
		(manual) =>
			!posts.some(
				(p) => p.id === manual.id || p.pathname === manual.pathname,
			),
	),
	...posts,
];

const allTags = [...new Set(allPosts.flatMap((post) => post.tags))].sort(); // comically inefficient, not too bad
const orderedTags = [
	...new Set(["Featured", ...allTags.filter((tag) => tag !== "Featured")]),
];
const sortedPosts = allPosts.sort(
	(a, b) =>
		parseDateOnlyAsLocalDate(b.date).getTime() -
		parseDateOnlyAsLocalDate(a.date).getTime(),
);
---

<Layout title="Home | My Blog">
	<script is:inline set:html={initPostsCode} />

	<div class="hero">
		<section class="introduction">
			<p class="typed-subtitle">
				<span id="typed-text"></span>
				<span class="cursor">|</span>
			</p>

			<div class="intro-row">
				<div class="hero-image" role="img"></div>

				<div class="intro-text">
					<p class="intro-paragraph">
						My name is 
						<a
							href="/post/about-me">Andy</a
						>. I'm an extended reality developer and history nerd.
						I've recreated a
						<a href="https://artsengine.engin.umich.edu/feast/big-city/"
							target="_blank"
							rel="noopener"
							aria-label="Resume">lost film</a>
						in VR, developed
						<a href="https://www.trymira.com/"
							target="_blank"
							rel="noopener"
							aria-label="Resume"
							>smart glasses</a
						>
						that remember everything, and built a neurotech
						<a href="/post/the-orbit-suite"
							>superhero simulator</a
						>. 
						<!-- Today, I'm defining the future with the
						Palantir Mixed Reality team. -->

						<br /><br />
						If you need fast information about me, check out my 
						<a href="/andy-yao-resume.pdf"
							target="_blank"
							rel="noopener"
							aria-label="Resume"
							>Resume</a
						> 
						or my 
						<a href="https://www.linkedin.com/in/andy-yao-cs"
							target="_blank"
							rel="noopener"
							aria-label="Resume"
							>LinkedIn</a
						>. 
						<br /><br />
						This website is intended to provide context for my experiences and my thinking. <br />
						As such, it has two entry types:<br />

  - <a
    class="special-link"
    style={`--special-link-color: ${TEXT_COLORS.Project};`}
    href="/"
    data-post-tag="Project">Projects</a>,
  descriptions of past work<br />

  - <a
    class="special-link"
    style={`--special-link-color: ${TEXT_COLORS.Thought};`}
    href="/"
    data-post-tag="Thought">Thoughts</a>,
  longer pieces of writing<br />
				</div>
			</div>
		</section>
	</div>

	<section class="posts-section" id="posts">
		<div class="filters">
			<div class="filters-header">
				<h2>Filter by Tags:</h2>
				<!-- <button class="expand-toggle" id="expand-toggle" type="button">
					Expand All
				</button> -->
			</div>
			<div class="tag-buttons">
				<button id="tag-all" class="filter-tag active"> All </button>
				{
					orderedTags.map((tag) => (
						<button class="filter-tag" data-tag={tag}>
							{tag}
						</button>
					))
				}
			</div>
		</div>

		<div class="posts-count">
			<p>
				Showing {sortedPosts.length} post{
					sortedPosts.length !== 1 ? "s" : ""
				}
			</p>
		</div>

		<div class="posts-list" id="posts-list">
			{
					sortedPosts.length > 0 ? (
						sortedPosts.map((post) => (
							<PostCard
								post={post}
								instanceKey={`list-${post.id}`}
								defaultExpanded={true}
							/>
						))
					) : (
					<p class="no-posts">
						No posts found with the selected tags.
					</p>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: flex-start;
		padding: clamp(2rem, 6vh, 4rem) 0 clamp(2rem, 8vh, 5rem) 0;
		gap: 2.5rem;
	}

	.card-container {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.introduction {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2.5rem;
		width: 100%;
	}

	.intro-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 4rem;
		width: 100%;
	}

	.intro-text {
		padding-top: 1.5rem;
	}

	.intro-paragraph {
		font-size: 1.15em;
		color: #8b949e;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		text-align: justify;
		text-justify: inter-word;
		hyphens: auto;
		justify-content: center;
		max-width: 320px;
		width: 100%;
	}

	.typed-subtitle {
		font-size: 3em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #000000;
		text-align: center;
		font-weight: 700;
	}

	.cursor {
		display: inline-block;
		opacity: 1;
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.cta-button {
		display: inline-block;
		background-color: #58a6ff;
		color: black;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.2s;
	}

	.cta-button:hover {
		background-color: #79c0ff;
	}

	.hero-image {
		width: 320px;
		height: 400px;
		border-radius: 8px;
		background-image: url("/images/babel.jpg");
		background-size: cover;
		background-position: center;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	.posts-section {
		margin-top: 3rem;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.filters {
		padding: 0.5rem;
		border-radius: 4px;
		margin-bottom: 0.5rem;
	}

	.filters-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: nowrap;
		margin-bottom: 0.4rem;
	}

	.filters h2 {
		margin-bottom: 0;
		font-size: 1.1em;
		white-space: nowrap;
	}

	.expand-toggle {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--chip-border);
		background: var(--chip-bg);
		color: var(--chip-text);
		border-radius: 20px;
		cursor: pointer;
		font-size: 0.9em;
		font-family: inherit;
		transition: all 0.2s;
	}

	.expand-toggle:hover {
		transform: translateY(-1px);
		border-color: var(--chip-hover-border);
		background: var(--chip-hover-bg);
		color: var(--chip-hover-text);
	}

	/* .expand-toggle:active {
		background: var(--chip-active-bg);
		border-color: var(--chip-active-border);
		color: var(--chip-active-text);
		transform: translateY(0);
	} */

	.tag-buttons {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.filter-tag {
		padding: 0.5rem 1rem;
		background-color: var(--chip-bg);
		border: 1px solid var(--chip-border);
		color: var(--chip-text);
		border-radius: 20px;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9em;
	}

	.filter-tag:hover {
		transform: translateY(-1px);
		background-color: var(--chip-hover-bg);
		border-color: var(--chip-hover-border);
		color: var(--chip-hover-text);
	}

	.filter-tag.active {
		background-color: var(--chip-active-bg);
		border-color: var(--chip-active-border);
		color: var(--chip-active-text);
	}

	.posts-count {
		margin: 0.5rem;
		margin-bottom: 2rem;
		color: #666;
		font-size: 0.95em;
	}

	.no-posts {
		text-align: center;
		color: #999;
		padding: 2rem;
		font-style: italic;
	}

	@media (max-width: 768px) {
		.hero {
			padding: 1.5rem 0 3rem 0;
			gap: 2rem;
		}

		.introduction {
			flex-direction: column;
			align-items: center;
			gap: 2rem;
		}

		.intro-row {
			flex-direction: column;
			align-items: center;
			gap: 2rem;
		}

		.intro-text {
			padding-top: 0;
			text-align: center;
		}

		.intro-paragraph {
			text-align: justify;
		}

		.typed-subtitle {
			text-align: center;
			font-size: 2rem;
			letter-spacing: 0.04em;
		}

		.hero-image {
			width: min(90vw, 320px);
			height: auto;
			aspect-ratio: 1 / 1;
		}

		.filters-header {
			gap: 0.75rem;
		}

		.filter-tag,
		.expand-toggle {
			font-size: 0.85rem;
			padding: 0.4rem 0.85rem;
		}

		.posts-count {
			margin-bottom: 1.5rem;
		}
	}
</style>

<script is:inline>
	document.addEventListener("astro:page-load", () => {
		initHero();
	});

	function initHero() {
		// Typed text
		const words = [
			"Hello",
			"👋😄",
			"你好",
			"こんにちは",
			"안녕하세요",
			"Bonjour",
			"Hola",
			"Ciao",
			"Saluton",
			"9jR°`N",
			"nuqneH",
			// "Congrats for waiting till the end",
			// "You found the easter egg!",
			// "If you email me, mention Pomegranates",
			// "Bye!",
			// "Help",
			// "Help me",
			// "pLeASe",
			// "itS cOmiNG",
			// "iM slIPPiNg",
			// "PLEA-"
		];

		const el = document.getElementById("typed-text");
		if (!el) return;

		const container =
			el.closest(".typed-subtitle") || el.parentElement || el;
		if (!container) return;
		if (container.dataset.typedInit === "1") return;
		container.dataset.typedInit = "1";

		let wordIndex = 0;
		let charIndex = 0;
		let deleting = false;
		let running = true;
		let timerId = null;

		const schedule = (ms) => {
			if (timerId) clearTimeout(timerId);
			timerId = setTimeout(tick, ms);
		};

		function tick() {
			if (!running) return;

			const word = String(words[wordIndex] || "");
			const chars = [...word];

			if (!deleting) {
				charIndex = Math.min(charIndex + 1, chars.length);
				el.textContent = chars.slice(0, charIndex).join("");
				if (charIndex >= chars.length) {
					//only the pivot back
					deleting = true;
					schedule(2000);
					return;
				}
				schedule(150);
				return;
			}

			charIndex = Math.max(charIndex - 1, 0);
			el.textContent = chars.slice(0, charIndex).join("");
			if (charIndex <= 0) {
				deleting = false;
				wordIndex = (wordIndex + 1) % words.length;
				schedule(1000);
				return;
			}
			schedule(150);
		}

		tick();
	}
</script>
