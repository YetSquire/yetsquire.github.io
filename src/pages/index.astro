---
import Layout from "../layouts/Layout.astro";
import { TEXT_COLORS } from "../config/site";
import PostCard from "../components/PostCard.astro";
import initPostsCode from "../scripts/init_posts.js?raw";
import slugify from "slugify";

const modules = import.meta.glob("../content/posts/**/*.{md,mdx}", {
	eager: true,
}) as Record<string, any>;

type Featured = {
	title: string;
	pathname: string;
};

const decodeHtmlEntities = (value: string): string => {
	return String(value || "")
		.replace(/&nbsp;/g, " ")
		.replace(/&amp;/g, "&")
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'")
		.replace(/&lt;/g, "<")
		.replace(/&gt;/g, ">")
		.replace(/&rsquo;|&lsquo;/g, "'")
		.replace(/&rdquo;|&ldquo;/g, '"');
};

const stripHtml = (value: string): string =>
	String(value || "").replace(/<[^>]*>/g, "");

const normalizeWhitespace = (value: string): string =>
	String(value || "")
		.replace(/\s+/g, " ")
		.trim();

const extractFirstSegment = async (
	mod: any,
	title: string,
): Promise<string> => {
	let source = "";

	try {
		if (typeof mod?.compiledContent === "function") {
			source = await mod.compiledContent();
		} else if (typeof mod?.rawContent === "function") {
			source = mod.rawContent();
		}
	} catch {
		// ignore
	}

	if (!source && typeof mod?.rawContent === "function") {
		try {
			source = mod.rawContent();
		} catch {
			// ignore
		}
	}

	source = String(source || "").replace(/^---[\s\S]*?---\s*/m, "");
	if (!source) return "";

	// Prefer the first meaningful <p> when content is HTML-exported.
	const titleLower = String(title || "").trim().toLowerCase();
	const pMatches = Array.from(source.matchAll(/<p\b[^>]*>([\s\S]*?)<\/p>/gi));
	for (const match of pMatches) {
		const raw = match?.[1] || "";
		const text = normalizeWhitespace(decodeHtmlEntities(stripHtml(raw)));
		if (!text) continue;
		if (titleLower && text.toLowerCase() === titleLower) continue;
		if (/^\d{1,2}\/\d{1,2}\/\d{2,4}$/.test(text)) continue;
		if (/^\d{4}-\d{2}-\d{2}$/.test(text)) continue;
		if (text.length < 25 && !/[.!?]/.test(text)) continue;
		return text;
	}

	// Markdown fallback: first non-empty paragraph-ish chunk.
	const cleaned = source
		.replace(/<style\b[\s\S]*?<\/style>/gi, "")
		.replace(/```[\s\S]*?```/g, "")
		.trim();

	const chunks = cleaned
		.split(/\n\s*\n/)
		.map((c) => normalizeWhitespace(decodeHtmlEntities(stripHtml(c))))
		.filter(Boolean);

	for (const chunk of chunks) {
		if (titleLower && chunk.toLowerCase() === titleLower) continue;
		if (chunk.length < 25 && !/[.!?]/.test(chunk)) continue;
		return chunk;
	}

	return "";
};

const parseDateOnlyAsLocalDate = (value: string): Date => {
	const m = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
	if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
	return new Date(value);
};

const posts = await Promise.all(Object.entries(modules).map(async ([path, mod]) => {
	const fm = mod.frontmatter || {};
	const pathEnd = path.split("/");
	const id = fm.id || pathEnd[pathEnd.length - 1].replace(/\.(md|mdx)$/, "");

	const routeImagePath = (imagePath: string): string => {
		if (!imagePath) return "";
		if (imagePath.startsWith("/") || imagePath.startsWith("http"))
			return imagePath;
		return `/images/posts/${id}/${imagePath}`;
	};

	const coverSource = fm.cover || fm.image || "";
	const cover = coverSource ? routeImagePath(coverSource) : "";

	const fmImages = Array.isArray(fm.images)
		? fm.images.slice()
		: fm.images
			? [fm.images]
			: [];
	if (fm.image && !fmImages.includes(fm.image)) fmImages.unshift(fm.image);
	const images = fmImages
		.map((img: string) => routeImagePath(img))
		.filter(Boolean);

	const fmVideos = Array.isArray(fm.videos)
		? fm.videos.slice()
		: fm.videos
			? [fm.videos]
			: [];
	if (fm.video && !fmVideos.includes(fm.video)) fmVideos.unshift(fm.video);
	const videos = fmVideos.filter(Boolean);

	return {
		id,
		title: fm.title || id,
		description: fm.description || "",
		excerpt: await extractFirstSegment(mod, fm.title || id),
		date: fm.date || "1970-01-01",
		tags: fm.tags || [],
		cover,
		images,
		videos,
		pathname: `/post/${id}`,
	};
}));

const manualPosts = [
	{
		id: "about-me",
		title: "About Me",
		description: "A quick overview of who I am and how to reach me.",
		excerpt: "A quick overview of who I am and how to reach me.",
		date: "2026-01-01",
		tags: ["About"],
		cover: "",
		images: [],
		videos: [],
		pathname: "/post/about-me",
	},
];

// function getFeaturedByTitle(title: string): Featured | null {
// 	const t = String(title || "").trim();
// 	if (!t) return null;

// 	const match = posts.find((p) => p.title === t);
// 	if (match) return { title: match.title, pathname: match.pathname };

// 	const slug = slugify(t, { lower: true, strict: true, trim: true });
// 	if (!slug) return null;
// 	return { title: t, pathname: `/post/${slug}` };
// }

// // Hardcode these by post title (exact match preferred).
// const FEATURED_A_TITLE = "About This Website";

// const featuredA = getFeaturedByTitle(FEATURED_A_TITLE);
// const featuredLinks = [featuredA].filter(
// 	(item): item is Featured => Boolean(item),
// );
// const featuredPosts = featuredLinks
// 	.map((item) => posts.find((post) => post.pathname === item.pathname))
// 	.filter(Boolean);

const allPosts = [
	...manualPosts.filter(
		(manual) => !posts.some((p) => p.id === manual.id || p.pathname === manual.pathname),
	),
	...posts,
];

const allTags = [...new Set(allPosts.flatMap((post) => post.tags))].sort(); // comically inefficient, not too bad
const sortedPosts = allPosts.sort(
	(a, b) =>
		parseDateOnlyAsLocalDate(b.date).getTime() -
		parseDateOnlyAsLocalDate(a.date).getTime(),
);
---

<Layout title="Home | My Blog">
	<script is:inline set:html={initPostsCode}></script>

	<div class="hero">
		<section class="introduction">
			<div class="hero-image" role="img"></div>

			<div class="intro-text">
				<p class="typed-subtitle">
					<span id="typed-text">Hello</span>
					<span class="cursor">|</span>
				</p>
				<p>
					My name is <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.About};`}
						href="/"
						data-post-tag="About">Andy</a
					>, an XR dev and history nerd

					<br/><br/>
					Here are my <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Project};`}
						href="/"
						data-post-tag="Project">projects</a
					>, here are my <a
						class="special-link"
						style={`--special-link-color: ${TEXT_COLORS.Blog};`}
						href="/"
						data-post-tag="Thought">thoughts</a
					>.
				</p>
			</div>
		</section>
	</div>

	<!-- <section class="featured">
		<h2>Featured</h2>
		<div class="posts-list">
			{featuredPosts.map((post) => (
				<PostCard
					post={post}
					instanceKey={`featured-${post.id}`}
					defaultExpanded={true}
					isFeatured={true}
				/>
			))}
		</div>
	</section> -->

	<section class="posts-section" id="posts">
		<div class="filters">
			<div class="filters-header">
				<h2>Filter by Tags:</h2>
				<button class="expand-toggle" id="expand-toggle" type="button">
					Expand All
				</button>
			</div>
			<div class="tag-buttons">
				<button
					id="tag-all"
					class="filter-tag active"
				>
					All
				</button>
				{
					allTags.map((tag) => (
						<button
							class="filter-tag"
							data-tag={tag}
						>
							{tag}
						</button>
					))
				}
			</div>
		</div>

		<div class="posts-count">
			<p>
				Showing {sortedPosts.length} post{sortedPosts.length !== 1 ? "s" : ""}
			</p>
		</div>

		<div class="posts-list" id="posts-list">
			{
				sortedPosts.length > 0 ? (
					sortedPosts.map((post) => (
						<PostCard post={post} instanceKey={`list-${post.id}`} />
					))
				) : (
					<p class="no-posts">No posts found with the selected tags.</p>
				)
			}
		</div>
	</section>
</Layout>

	<style>
		.hero {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-start;
			padding: clamp(2rem, 6vh, 4rem) 0 clamp(2rem, 8vh, 5rem) 0;
			gap: 2.5rem;
		}

	.card-container {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.introduction {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 4rem;
		width: 100%;
	}

	.intro-text {
		padding-top: 1.5rem;
	}

	.intro-text > p:not(.typed-subtitle) {
		font-size: 1.15rem;
		color: #8b949e;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		text-align: left;
		justify-content: center;
		white-space: nowrap;
		overflow-x: auto;
	}

	.typed-subtitle {
		font-size: 2.5rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #000000;
		text-align: center;
		margin-bottom: 2rem;
		font-weight: 700;
	}

	.cursor {
		display: inline-block;
		opacity: 1;
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.cta-button {
		display: inline-block;
		background-color: #58a6ff;
		color: black;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.2s;
	}

	.cta-button:hover {
		background-color: #79c0ff;
	}

	.hero-image {
		width: 250px;
		height: 250px;
		border-radius: 8px;
		background-image: url("/images/babel.jpg");
		background-size: cover;
		background-position: center;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
	}

	.posts-section {
		margin-top: 3rem;
	}

	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.filters {
		padding: 0.5rem;
		border-radius: 4px;
		margin-bottom: 0.5rem;
	}

	.filters-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.4rem;
	}

	.filters h2 {
		margin-bottom: 0.4rem;
		font-size: 1.1rem;
	}

	.expand-toggle {
		padding: 0.45rem 0.9rem;
		border: 2px solid #ddd;
		background: #ffffff;
		border-radius: 20px;
		cursor: pointer;
		font-size: 0.9rem;
		font-family: inherit;
		transition: all 0.2s;
	}

	.expand-toggle:hover {
		border-color: #0066cc;
		color: #0066cc;
	}

	.tag-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.filter-tag {
		padding: 0.5rem 1rem;
		background-color: white;
		border: 2px solid #ddd;
		border-radius: 20px;
		color: #333;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9rem;
		font-family: inherit;
	}

	.filter-tag:hover {
		border-color: #0066cc;
		color: #0066cc;
	}

	.filter-tag.active {
		background-color: #0066cc;
		border-color: #0066cc;
		color: white;
	}

	.posts-count {
		margin: 0.5rem;
		margin-bottom: 2rem;
		color: #666;
		font-size: 0.95rem;
	}

	.no-posts {
		text-align: center;
		color: #999;
		padding: 2rem;
		font-style: italic;
	}
</style>

<script is:inline>
	document.addEventListener("astro:page-load", () => {
		initHero();
	});

	function initHero() {
		// Typed text
		const words = [
			"Hello",
			"👋😄",
			"你好",
			"こんにちは",
			"안녕하세요",
			"Bonjour",
			"Hola",
			"Ciao",
			"Saluton",
			"9jR°`N",
			"nuqneH",
			// "Congrats for waiting till the end",
			// "You found the easter egg!",
			// "If you email me, mention Pomegranates",
			// "Bye!",
			// "Help",
			// "Help me",
			// "pLeASe",
			// "itS cOmiNG",
			// "iM slIPPiNg",
			// "PLEA-"
		];

		const el = document.getElementById("typed-text");
		if (!el) return;

		const container =
			el.closest(".typed-subtitle") || el.parentElement || el;
		if (!container) return;
		if (container.dataset.typedInit === "1") return;
		container.dataset.typedInit = "1";

		let wordIndex = 0;
		let charIndex = 5;
		let deleting = true;
		let running = true;
		let timerId = null;

		const schedule = (ms) => {
			if (timerId) clearTimeout(timerId);
			timerId = setTimeout(tick, ms);
		};

		function tick() {
			if (!running) return;

			const word = String(words[wordIndex] || "");
			const chars = [...word];

			if (!deleting) {
				charIndex = Math.min(charIndex + 1, chars.length);
				el.textContent = chars.slice(0, charIndex).join("");
				if (charIndex >= chars.length) { //only the pivot back
					deleting = true;
					schedule(2000);
					return;
				}
				schedule(150);
				return;
			}

			charIndex = Math.max(charIndex - 1, 0);
			el.textContent = chars.slice(0, charIndex).join("");
			if (charIndex <= 0) {
				deleting = false;
				wordIndex = (wordIndex + 1) % words.length;
				schedule(1000);
				return;
			}
			schedule(150);
		}

		tick();
	}
</script>
