---
import Layout from "../layouts/Layout.astro";

//todo- optimize typeloop
//todo- make a most viewed posts suggestion! along with the other two suggestions

// Find latest post by inspecting the directory structure under src/content/posts
// We pick the highest year directory, then highest month directory inside it,
// then choose the newest post by frontmatter `date` inside that folder.
const modules = import.meta.glob("../content/posts/**/*.mdx", {
	eager: true,
}) as Record<string, any>;

type PostMeta = {
	id: string;
	title: string;
	date: string;
};

function getLatestByTag(tag: string): PostMeta | null {
	const allPosts = Object.entries(modules).map(([path, mod]) => {
		const fm = mod.frontmatter || {};
		const parts = path.split("/");
		const filename = parts[parts.length - 1];

		const year = Number(parts[parts.length - 3]) || 0;
		const month = Number(parts[parts.length - 2]) || 0;
		const id = fm.id || filename.replace(/\.mdx$/, "");

		return {
			id,
			fm,
			path,
			year,
			month,
			tags: fm.tags || [],
		};
	});

	// 1. Filter by tag
	const taggedPosts = allPosts.filter(
		(p) => Array.isArray(p.tags) && p.tags.includes(tag),
	);

	if (taggedPosts.length === 0) return null;

	// 2. Latest year
	const latestYear = Math.max(...taggedPosts.map((p) => p.year));
	const inYear = taggedPosts.filter((p) => p.year === latestYear);

	// 3. Latest month
	const latestMonth = Math.max(...inYear.map((p) => p.month));
	const inMonth = inYear.filter((p) => p.month === latestMonth);

	// 4. Sort by frontmatter date
	inMonth.sort(
		(a, b) =>
			new Date(b.fm.date || "1970-01-01").getTime() -
			new Date(a.fm.date || "1970-01-01").getTime(),
	);

	const latest = inMonth[0];
	if (!latest) return null;

	return {
		id: latest.id,
		title: latest.fm.title || latest.id,
		date: latest.fm.date || "",
	};
}

const latestBlog = getLatestByTag("blog");
const latestProject = getLatestByTag("project");
---

<Layout title="Home | My Blog">

	<div class="hero">
		<section class="hello-container">
			<!-- data-hide-nav -->
			<h1 class="dynamic-hello">
				<span>
					<span id="typed-text"></span>
					<span class="cursor">|</span>
				</span>
			</h1>

			<button class="scroll-button" id="scroll-next"> ↓ </button>
		</section>

		<section class="introduction" id="introduction">
			<div class="card-container">
				<div
					class="card-widget"
					tabindex="0"
					aria-label="Hero image cards"
				>
					<div class="card card--back">
						<img src="/images/babel.jpg" alt="back" />
					</div>
					<div class="card card--front">
						<img src="/images/test.png" alt="front" />
					</div>
				</div>
			</div>

			<div class="intro-text">
				<p>
					My name is Andy, developer, history nerd, and aspiring
					human.
					<br /><br />
					I like building <a
						class="intro-link"
						style="--intro-link-color: #00ff08;"
						href="/posts?tags=projects">wearable tech</a
					> and thinking about the <a
						class="intro-link"
						style="--intro-link-color: #0290dd;"
						href="/posts?tags=blog">past</a
					>.
					<br /><br />
					You can read about that in my <a
						class="intro-link"
						style="--intro-link-color: #ffff09;"
						href="/posts">posts</a
					>.
					<br /><br />
					To learn more about myself and this website, see the <a
						class="intro-link"
						style="--intro-link-color: #8e7745;"
						href="/about">about</a
					> page.
				</p>
			</div>
		</section>
	</div>

	<section class="featured">
		<h2>Featured</h2>

		<div class="featured-grid">
			<a
				class="feature-card"
				href={latestBlog ? `/post/${latestBlog.id}` : "/posts"}
			>
				<h3>Latest Blog</h3>
				<p class="muted">
					{latestBlog ? latestBlog.title : "No posts yet"}
				</p>
			</a>

			<a
				class="feature-card"
				href={latestProject ? `/post/${latestProject.id}` : "/posts"}
			>
				<h3>Latest Project</h3>
				<p class="muted">
					{latestProject ? latestProject.title : "No projects yet"}
				</p>
			</a>

			<!-- most viewed project -->
			<!-- <a class="feature-card" href="/posts?tags=projects">
				<h3>Projects</h3>
				<p class="muted">View posts tagged "projects"</p>
			</a> -->
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		align-items: center;
		padding: 3rem 0;
		border-bottom: 2px solid #30363d;
		margin-bottom: 2rem;
	}

	.card-container {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hero-image {
		width: 100%;
		max-width: 420px;
		height: auto;
		border-radius: 8px;
		object-fit: cover;
	}

	.hello-container {
		min-height: 100svh;
	}

	.introduction {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		min-height: 100svh;
		gap: 6rem;
	}

	.intro-text p {
		font-size: 1.15rem;
		color: #8b949e;
		margin-bottom: 1.25rem;
		line-height: 1.6;
		text-align: left;
		justify-content: center;
	}

	.intro-link {
		position: relative;
		top: 8px;
		color: var(--intro-link-color, #58a6ff);
		font-weight: 600;
		text-decoration: none;
		overflow: hidden;
		display: inline-block;
	}

	.intro-link::before {
		content: "";
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(88, 166, 255, 0.3),
			transparent
		);
		transition: left 0.5s ease-in-out;
	}

	.intro-link:hover::before {
		left: 100%;
	}

	.intro-link:hover {
		color: var(--intro-link-color, #79c0ff);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.dynamic-hello {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);

		font-size: clamp(3rem, 8vw, 6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.scroll-button {
		position: absolute;
		top: calc(50% + 37.5svh);
		left: 50%;
		transform: translateX(-50%);

		font-size: 1rem;
		padding: 0.75rem 1.5rem;
		border-radius: 999px;
		border: none;
		cursor: pointer;
	}

	.cursor {
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.cta-button {
		display: inline-block;
		background-color: #58a6ff;
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.2s;
	}

	.cta-button:hover {
		background-color: #79c0ff;
	}

	.featured {
		text-align: center;
		margin: 0 auto;
	}

	.featured h2 {
		margin-bottom: 1rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}

	/* Card widget styles */
	.card-widget {
		position: relative;
		width: 400px;
		height: 500px;
		display: inline-block;
		cursor: pointer;
	}

	.card-widget .card {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
		transition:
			transform 300ms cubic-bezier(0.2, 0.9, 0.2, 1),
			box-shadow 300ms;
	}

	.card-widget img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card--back {
		transform: translate(12px, 8px) rotate(-6deg) skew(-4deg);
		z-index: 1;
	}
	.card--front {
		transform: translate(-8px, -6px) rotate(6deg) skew(4deg);
		z-index: 2;
	}

	.card-widget.is-swapped .card--back {
		transform: translate(-8px, -6px) rotate(6deg) skew(4deg);
		z-index: 2;
	}
	.card-widget.is-swapped .card--front {
		transform: translate(12px, 8px) rotate(-6deg) skew(-4deg);
		z-index: 1;
	}

	.card-widget:hover .card,
	.card-widget:focus .card,
	.card-widget.is-swapped .card {
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
	}

	@media (max-width: 780px) {
		.card-widget {
			width: 220px;
			height: 150px;
		}
	}

	.feature-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid #30363d;
		border-radius: 4px;
		text-decoration: none;
		color: inherit;
		transition: all 0.2s;
		background-color: #0d1117;
	}

	.feature-card:hover {
		border-color: #58a6ff;
		box-shadow: 0 0 12px rgba(88, 166, 255, 0.2);
	}

	.feature-card h3 {
		margin-bottom: 0.5rem;
		color: #f0f6fc;
	}

	.muted {
		color: #8b949e;
		font-size: 0.95rem;
	}
</style>

<script is:inline>

	document.addEventListener("astro:page-load", () => {
		const widget = document.querySelector(".card-widget");
		if (!widget) return;

		widget.addEventListener("click", () => {
			widget.classList.toggle("is-swapped");
		});
	});

	function initHero() {
		// Scroll button
		const scrollBtn = document.getElementById("scroll-next");
		scrollBtn?.addEventListener("click", () => {
			const next = document.querySelector(".introduction");
			next?.scrollIntoView({ behavior: "smooth", block: "start" });
		});

		// Typed text
		const words = [
			"Hello",
			"👋😄",
			"你好",
			"こんにちは",
			"안녕하세요",
			"Bonjour",
			"Hola",
			"Ciao",
			"Saluton",
			"9jR°`N",
			"4E 45 45 45 45 45 45 45 45 52 44",
			"nuqneH",
			"Congrats for waiting till the end",
			"You found the easter egg!",
			"If you email me, mention Pomegranates",
			"Bye!",
			// "Help",
			// "Help me",
			// "pLeASe",
			// "itS cOmiNG",
			// "iM slIPPiNg",
			// "PLEA-"
		];

		const el = document.getElementById("typed-text");
		if (!el) return;

		let wordIndex = 0;
		let charIndex = 0;
		let deleting = false;

		let colorStart = "#ffffff";
		const colors = [
			"#00ff08",
			"#0290dd",
			"#ffff09",
			"#ff61a6",
			"#ff7b72",
			"#d2a8ff",
		];

		function typeLoop() {
			const word = words[wordIndex];

			if (!deleting) {
				const chars = [...word];
				el.textContent = chars.slice(0, charIndex++).join("");
				if (charIndex === word.length) {
					setTimeout(() => {
						deleting = true;
					}, 1200);
				}
			} else {
				const chars = [...word];
				el.textContent = chars.slice(0, charIndex--).join("");				
				if (charIndex <= 0) {
					deleting = false;
					wordIndex = (wordIndex + 1) % words.length;
					charIndex = 0;
				}
			}

			setTimeout(typeLoop, deleting ? 60 : 100);
		}

		typeLoop();
	}

	// Run on first load and every client-side navigation
	document.addEventListener("astro:page-load", initHero);

</script>
