---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';

//TODO- load only a limited number of posts for performance
const numberOfPostsToLoad = 100;

// Load all markdown post files from the content directory
const modules = import.meta.glob('../content/posts/**/*.md', { eager: true }) as Record<string, any>;
const posts = Object.entries(modules).map(([path, mod]) => {
	const fm = mod.frontmatter || {};
	const pathEnd = path.split('/');
	const id = fm.id || pathEnd[pathEnd.length - 1].replace(/\.md$/, '');

	// Helper function to auto-route image paths
	const routeImagePath = (imagePath: string): string => {
		if (!imagePath) return '';
		// If already a full URL or absolute path, leave as-is
		if (imagePath.startsWith('/') || imagePath.startsWith('http')) return imagePath;
		// Otherwise, prefix with /images/posts/{id}/
		return `/images/posts/${id}/${imagePath}`;
	};

	// Support either `cover` or legacy/single `image` field for cover
	const coverSource = fm.cover || fm.image || '';
	const cover = coverSource ? routeImagePath(coverSource) : '';

	// Normalize images: support `images` array and single `image` field
	const fmImages = Array.isArray(fm.images) ? fm.images.slice() : (fm.images ? [fm.images] : []);
	if (fm.image && !fmImages.includes(fm.image)) fmImages.unshift(fm.image);
	const images = fmImages.map((img: string) => routeImagePath(img)).filter(Boolean);

	// Normalize videos: support `videos` array and single `video` field
	const fmVideos = Array.isArray(fm.videos) ? fm.videos.slice() : (fm.videos ? [fm.videos] : []);
	if (fm.video && !fmVideos.includes(fm.video)) fmVideos.unshift(fm.video);
	const videos = fmVideos.filter(Boolean);

	return {
		id,
		title: fm.title || id,
		description: fm.description || '',
		date: fm.date || '1970-01-01',
		tags: fm.tags || [],
		cover,
		images,
		videos,
		pathname: fm.pathname,
		content: fm.content || '',
		file: path,
	};
});

// Get all unique tags
const allTags = [...new Set(posts.flatMap(post => post.tags))].sort();

// Get selected tags from URL params
const selectedTags = new URL(Astro.request.url).searchParams.getAll('tags');

// Filter posts based on selected tags
const filteredPosts = selectedTags.length > 0
	? posts.filter(post => selectedTags.some(tag => post.tags.includes(tag)))
	: posts;

// Sort posts by date (newest first)
const sortedPosts = filteredPosts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Posts | My Blog">
	<h1>Blog Posts</h1>

	<div class="filters">
		<h3>Filter by Tags:</h3>
		<div class="tag-buttons">
			<button
				id="tag-all"
				class={`filter-tag ${selectedTags.length === 0 ? 'active' : ''}`}
			>
				All
			</button>
			{allTags.map(tag => (
				<button
					class={`filter-tag ${selectedTags.includes(tag) ? 'active' : ''}`}
					data-tag={tag}
				>
					{tag}
				</button>
			))}
		</div>
	</div>

	<div class="posts-count">
		<p>Showing {sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''}</p>
	</div>

	<div class="posts-list" id="posts-list">
		{sortedPosts.length > 0 ? (
			sortedPosts.map(post => (
				<PostCard post={post} />
			))
		) : (
			<p class="no-posts">No posts found with the selected tags.</p>
		)}
	</div>
</Layout>

<style>
	h1 {
		margin-bottom: 2rem;
	}

	.filters {
		background-color: #f9f9f9;
		padding: 1.5rem;
		border-radius: 8px;
		margin-bottom: 2rem;
	}

	.filters h3 {
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.tag-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.filter-tag {
		padding: 0.5rem 1rem;
		background-color: white;
		border: 2px solid #ddd;
		border-radius: 20px;
		color: #333;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9rem;
	}

	.filter-tag:hover {
		border-color: #0066cc;
		color: #0066cc;
	}

	.filter-tag.active {
		background-color: #0066cc;
		border-color: #0066cc;
		color: white;
	}

	.posts-count {
		margin-bottom: 1.5rem;
		color: #666;
		font-size: 0.95rem;
	}

	.no-posts {
		text-align: center;
		color: #999;
		padding: 2rem;
		font-style: italic;
	}
</style>

<script define:vars={{ initialSelectedTags: selectedTags }}>
// Client-side filtering without rebuilding HTML to preserve component styles
const currentSelectedTags = new Set(initialSelectedTags);
const postListEl = document.getElementById('posts-list');
const tagButtons = Array.from(document.querySelectorAll('.filter-tag'));
const allBtn = document.getElementById('tag-all');
const postsCountEl = document.querySelector('.posts-count p');

function getPostCards() {
    return Array.from(postListEl.querySelectorAll('.post-card'));
}

function updateButtonStates() {
    tagButtons.forEach(btn => {
        const tag = btn.getAttribute('data-tag');
        if (tag) btn.classList.toggle('active', currentSelectedTags.has(tag));
        else if (btn.id === 'tag-all') btn.classList.toggle('active', currentSelectedTags.size === 0);
    });
}

function renderPosts() {
    const cards = getPostCards();
    let visibleCount = 0;
    cards.forEach(card => {
        const tags = (card.dataset.tags || '').split(',').map(t => t.trim()).filter(Boolean);
        const matches = currentSelectedTags.size === 0 || tags.some(t => currentSelectedTags.has(t));
        card.style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
    });
    postsCountEl.textContent = `Showing ${visibleCount} post${visibleCount !== 1 ? 's' : ''}`;

    const queryParams = Array.from(currentSelectedTags).map(t => `tags=${encodeURIComponent(t)}`).join('&');
    const newUrl = queryParams ? `/posts?${queryParams}` : '/posts';
    window.history.replaceState(null, '', newUrl);
}

if (allBtn) {
    allBtn.addEventListener('click', (e) => {
        e.preventDefault();
        currentSelectedTags.clear();
        updateButtonStates();
        renderPosts();
    });
}

tagButtons.forEach(btn => {
    const tag = btn.getAttribute('data-tag');
    if (!tag) return;
    btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (currentSelectedTags.has(tag)) currentSelectedTags.delete(tag);
        else currentSelectedTags.add(tag);
        updateButtonStates();
        renderPosts();
    });
});

// initial state
updateButtonStates();
renderPosts();
</script>
