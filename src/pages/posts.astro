---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";

//TODO- load only a limited number of posts for performance
//TODO- keep posts that are still relevant around
//TODO- add filter by date
const numberOfPostsToLoad = 100;

const parseDateOnlyAsLocalDate = (value: string): Date => {
	const m = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
	if (m) return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
	return new Date(value);
};

// Load all markdown post files from the content directory
const modules = import.meta.glob("../content/posts/**/*.md", {
	eager: true,
}) as Record<string, any>;
const posts = Object.entries(modules).map(([path, mod]) => {
	const fm = mod.frontmatter || {};
	const pathEnd = path.split("/");
	const id = fm.id || pathEnd[pathEnd.length - 1].replace(/\.md$/, "");

	// Helper function to auto-route image paths
	const routeImagePath = (imagePath: string): string => {
		if (!imagePath) return "";
		// If already a full URL or absolute path, leave as-is
		if (imagePath.startsWith("/") || imagePath.startsWith("http"))
			return imagePath;
		// Otherwise, prefix with /images/posts/{id}/
		return `/images/posts/${id}/${imagePath}`;
	};

	// Support either `cover` or legacy/single `image` field for cover
	const coverSource = fm.cover || fm.image || "";
	const cover = coverSource ? routeImagePath(coverSource) : "";

	// Normalize images: support `images` array and single `image` field
	const fmImages = Array.isArray(fm.images)
		? fm.images.slice()
		: fm.images
			? [fm.images]
			: [];
	if (fm.image && !fmImages.includes(fm.image)) fmImages.unshift(fm.image);
	const images = fmImages
		.map((img: string) => routeImagePath(img))
		.filter(Boolean);

	// Normalize videos: support `videos` array and single `video` field
	const fmVideos = Array.isArray(fm.videos)
		? fm.videos.slice()
		: fm.videos
			? [fm.videos]
			: [];
	if (fm.video && !fmVideos.includes(fm.video)) fmVideos.unshift(fm.video);
	const videos = fmVideos.filter(Boolean);

	return {
		id,
		title: fm.title || id,
		description: fm.description || "",
		date: fm.date || "1970-01-01",
		tags: fm.tags || [],
		cover,
		images,
		videos,
		pathname: fm.pathname,
		content: fm.content || "",
		file: path,
	};
});

// Get all unique tags
const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort();

// Get selected tags from URL params
const selectedTags = new URL(Astro.request.url).searchParams.getAll("tags");

// Filter posts based on selected tags
const filteredPosts =
	selectedTags.length > 0
		? posts.filter((post) =>
				selectedTags.some((tag) => post.tags.includes(tag)),
			)
		: posts;

// Sort posts by date (newest first)
const sortedPosts = filteredPosts.sort(
	(a, b) =>
		parseDateOnlyAsLocalDate(b.date).getTime() -
		parseDateOnlyAsLocalDate(a.date).getTime(),
);
---

<Layout title="Posts | My Blog">
	<script type="module">
		import { initPostsFilter } from "/src/scripts/init_posts.js";
		document.addEventListener("astro:page-load", initPostsFilter);
		initPostsFilter(); // In case astro:page-load doesn't fire
	</script>

	<h1>Posts</h1>

	<div class="filters">
		<h3>Filter by Tags:</h3>
		<div class="tag-buttons">
			<button
				id="tag-all"
				class={`filter-tag ${selectedTags.length === 0 ? "active" : ""}`}
			>
				All
			</button>
			{
				allTags.map((tag) => (
					<button
						class={`filter-tag ${selectedTags.includes(tag) ? "active" : ""}`}
						data-tag={tag}
					>
						{tag}
					</button>
				))
			}
		</div>
	</div>

	<div class="posts-count">
		<p>
			Showing {sortedPosts.length} post{
				sortedPosts.length !== 1 ? "s" : ""
			}
		</p>
	</div>

	<div class="posts-list" id="posts-list">
		{
			sortedPosts.length > 0 ? (
				sortedPosts.map((post) => <PostCard post={post} />)
			) : (
				<p class="no-posts">No posts found with the selected tags.</p>
			)
		}
	</div>
</Layout>

<style>
	h1 {
		margin-bottom: 1rem;
	}

	.filters {
		padding: 0.5rem;
		border-radius: 4px;
		margin-bottom: 0.5rem;
	}

	.filters h3 {
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.tag-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.filter-tag {
		padding: 0.5rem 1rem;
		background-color: white;
		border: 2px solid #ddd;
		border-radius: 20px;
		color: #333;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9rem;
	}

	.filter-tag:hover {
		border-color: #0066cc;
		color: #0066cc;
	}

	.filter-tag.active {
		background-color: #0066cc;
		border-color: #0066cc;
		color: white;
	}

	.posts-count {
		margin: 0.5rem;
		margin-bottom: 2rem;
		color: #666;
		font-size: 0.95rem;
	}

	.no-posts {
		text-align: center;
		color: #999;
		padding: 2rem;
		font-style: italic;
	}
</style>
