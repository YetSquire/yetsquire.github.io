---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/posts';

// Get all unique tags
const allTags = [...new Set(posts.flatMap(post => post.tags))].sort();

// Get selected tags from URL params
const selectedTags = new URL(Astro.request.url).searchParams.getAll('tags');

// Filter posts based on selected tags
const filteredPosts = selectedTags.length > 0
	? posts.filter(post => selectedTags.some(tag => post.tags.includes(tag)))
	: posts;

// Sort posts by date (newest first)
const sortedPosts = filteredPosts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Posts | My Blog">
	<h1>Blog Posts</h1>

	<div class="filters">
		<h3>Filter by Tags:</h3>
		<div class="tag-buttons">
			<a 
				href="/posts" 
				class={`filter-tag ${selectedTags.length === 0 ? 'active' : ''}`}
			>
				All
			</a>
			{allTags.map(tag => {
				const isActive = selectedTags.includes(tag);
				const newTags = isActive
					? selectedTags.filter(t => t !== tag)
					: [...selectedTags, tag];
				const queryParams = newTags.map(t => `tags=${encodeURIComponent(t)}`).join('&');
				const href = newTags.length > 0 ? `/posts?${queryParams}` : '/posts';
				
				return (
					<a 
						href={href}
						class={`filter-tag ${isActive ? 'active' : ''}`}
					>
						{tag}
					</a>
				);
			})}
		</div>
	</div>

	<div class="posts-count">
		<p>Showing {sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''}</p>
	</div>

	<div class="posts-list">
		{sortedPosts.length > 0 ? (
			sortedPosts.map(post => (
				<PostCard post={post} />
			))
		) : (
			<p class="no-posts">No posts found with the selected tags.</p>
		)}
	</div>
</Layout>

<style>
	h1 {
		margin-bottom: 2rem;
	}

	.filters {
		background-color: #f9f9f9;
		padding: 1.5rem;
		border-radius: 8px;
		margin-bottom: 2rem;
	}

	.filters h3 {
		margin-bottom: 1rem;
		font-size: 1rem;
	}

	.tag-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.filter-tag {
		padding: 0.5rem 1rem;
		background-color: white;
		border: 2px solid #ddd;
		border-radius: 20px;
		text-decoration: none;
		color: #333;
		cursor: pointer;
		transition: all 0.2s;
		font-size: 0.9rem;
	}

	.filter-tag:hover {
		border-color: #0066cc;
		color: #0066cc;
	}

	.filter-tag.active {
		background-color: #0066cc;
		border-color: #0066cc;
		color: white;
	}

	.posts-count {
		margin-bottom: 1.5rem;
		color: #666;
		font-size: 0.95rem;
	}

	.no-posts {
		text-align: center;
		color: #999;
		padding: 2rem;
		font-style: italic;
	}
</style>
