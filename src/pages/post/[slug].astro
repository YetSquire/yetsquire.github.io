---
import Layout from '../../layouts/Layout.astro';

const { params } = Astro;
const slug = params.slug;

// load all markdown posts
const modules = import.meta.glob('../../content/posts/**/*.md', { eager: true }) as Record<string, any>;

// find module by frontmatter id or filename
let mod = null;
for (const [path, m] of Object.entries(modules)) {
    const fm = m.frontmatter || {};
    const parts = path.split('/');
    const filename = parts[parts.length - 1].replace(/\.md$/, '');
    if (fm.id === slug || filename === slug) {
        mod = m;
        break;
    }
}

if (!mod) {
    throw new Error(`Post not found: ${slug}`);
}

const fm = mod.frontmatter || {};
const Content = mod.default;
const assetId = fm.id || slug;

export async function getStaticPaths() {
    const modules = import.meta.glob('../../content/posts/**/*.md', { eager: true }) as Record<string, any>;
    const paths = Object.entries(modules).map(([path, mod]) => {
        const fm = mod.frontmatter || {};
        const parts = path.split('/');
        const filename = parts[parts.length - 1].replace(/\.md$/, '');
        const postSlug = fm.id || filename;
        return { params: { slug: postSlug } };
    });
    return paths;
}

// Helper to route image paths same as posts listing
const routeImagePath = (imagePath: string): string => {
    if (!imagePath) return '';
    if (imagePath.startsWith('/') || imagePath.startsWith('http')) return imagePath;
    return `/images/posts/${assetId}/${imagePath}`;
};

const cover = fm.cover || fm.image ? (routeImagePath(fm.cover || fm.image)) : '';
const images = (Array.isArray(fm.images) ? fm.images : (fm.images ? [fm.images] : [])).map((i: string) => routeImagePath(i));
const videos = Array.isArray(fm.videos) ? fm.videos : (fm.videos ? [fm.videos] : []);
---

<Layout title={fm.title || slug}>
    <article class="post-full">
        {cover && <img class="cover" src={cover} alt={fm.title} />}

        <section class="post-content">
            <Content />
        </section>
    </article>
</Layout>
