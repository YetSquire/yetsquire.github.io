---
import Layout from "../../layouts/Layout.astro";
import { loadGeneratedPosts } from "../../lib/posts";

const postLinks = (await import("../../content/post_links.json")).default as Record<string, string>;
const slug = String(Astro.params.slug || "");
const allPosts = loadGeneratedPosts(postLinks);
const post = Astro.props.post || allPosts.find((entry) => entry.id === slug);

if (!post) {
	throw new Error(`Post not found: ${slug}`);
}

const redirectUrl = post.externalUrl;

export async function getStaticPaths() {
	const postLinks = (await import("../../content/post_links.json")).default as Record<string, string>;
	const posts = loadGeneratedPosts(postLinks);
return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}
---

<Layout title={post.title || slug}>
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300&display=swap"
			rel="stylesheet"
		/>
		{redirectUrl && <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />}
		{redirectUrl && <link rel="canonical" href={redirectUrl} />}
	</head>
	{redirectUrl ? (
		<article class="post-full post-full--redirect">
			<p>
				Redirecting to{" "}
				<a href={redirectUrl}>{redirectUrl}</a>.
			</p>
			<script is:inline>
				{`window.location.replace(${JSON.stringify(redirectUrl)});`}
			</script>
		</article>
	) : (
		<article class="post-full">
			{post.cover && <img class="cover" src={post.cover} alt={post.title} />}
			<section class="post-content" set:html={post.html} />
		</article>
	)}
</Layout>

<style is:global>
	.post-full {
		margin-top: 2rem;
		opacity: 0;
		transition: opacity 280ms ease;
	}

	html:not(.post-loading) .post-full {
		opacity: 1;
	}

	.post-content {
		overflow-wrap: anywhere;
	}

	.post-content img {
		max-width: 100%;
		height: auto;
	}

	.post-content a[href] {
		word-break: break-word;
	}
</style>
