---
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
}

const { title } = Astro.props;

const isPostsPage = Astro.url.pathname.startsWith('/post/');
const isHomePage = Astro.url.pathname === "/";
const isAboutPage = Astro.url.pathname === "/post/about-me";
const showSocialHeader = isHomePage || isAboutPage;
---

<html lang="en">
	    <head>
	        <meta charset="utf-8" />
	        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	        <meta name="viewport" content="width=device-width" />
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

	        <link
	            href="https://fonts.googleapis.com/css2?family=Antic&display=swap"
	            rel="stylesheet"
	        />
            {isPostsPage && (
                <>
                    <link
                        rel="preload"
                        href="https://fonts.gstatic.com/s/merriweather/v30/u-440qyriQwlOrhSvowK_l521wRpX-BI.woff2"
                        as="font"
                        type="font/woff2"
                        crossorigin
                    />
                    <link
                        href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300&display=block"
                        rel="stylesheet"
                    />
                </>
            )}
	        <title>{title}</title>
	        <ClientRouter />
	        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --chip-bg: #ffffff;
                --chip-text: #666;
                --chip-border: #999;

                --chip-hover-bg: #ffffff;
                --chip-hover-text: #333;
                --chip-hover-border: #333;
                
                --chip-active-bg: #666;
                --chip-active-text: #ffffff;
                --chip-active-border: #333;
            }

            html {
                background-color: #ffffff;
                color: #000000;
            }

            body {
                font-family:
                    "Antic",
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                line-height: 1.6;
                color: #000000;
                background-color: #ffffff;
            }

            body.post-page .post-content {
                font-family:
                    "Merriweather",
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                font-size: 11pt;
                font-weight: 300;
                line-height: 1.6;
            }

            button,
            input,
            textarea,
            select {
                font: inherit;
            }

            main {
                max-width: 800px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }

            footer {
                margin-top: 4rem;
                padding: 2rem 1rem;
                background-color: #ffffff;
                text-align: center;
                color: #666666;
                font-size: 0.9rem;
                border-top: 1px solid #e5e7eb;
                font-family: "Antic" !important;
            }

            footer p {
                font-family: "Antic" !important;
            }

            a {
                color: #1a73e8;
                text-decoration: none;
                transition: color 0.2s;
            }

            a:hover {
                color: #1557b0;
                text-decoration: underline;
            }

            .posts-header {
                position: static;
                padding: 0.5rem 1rem;
            }

            .posts-header--social {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .home-header {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                padding: 0.5rem 1rem;
            }

            .home-social {
                display: inline-flex;
                gap: 0.6rem;
                align-items: center;
            }

            .home-social a:hover {
                text-decoration: none;
            }

            .social-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 50px;
                height: 50px;
                border-radius: 999px;
                border: 1px solid #e2e2e2;
                color: #000000;
                text-decoration: none;
                background: #fff;
                transition: transform 160ms ease, border-color 160ms ease;
                font-size: 1.5rem;
                line-height: 1;
            }

            .social-icon:hover,
            .social-icon:focus-visible {
                transform: translateY(-2px);
                border-color: #111;
                outline: none;
            }

            .social-icon-img {
                width: 30px;
                height: 30px;
                object-fit: contain;
                display: block;
                filter: grayscale(100%);
            }

            .sr-only {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }

            .home-overlay-link {
                display: inline-flex;
                align-items: baseline;
                color: rgb(0, 0, 0);
                text-decoration: none;
                line-height: 1;
                font-size: 1.5rem;
                -webkit-backdrop-filter: blur(8px);
                backdrop-filter: blur(8px);
                transition: transform 0.3s;
                gap: 0.4rem;
            }

            .home-overlay-link:hover {
                color: rgb(0, 0, 0);
            }

            .arrow {
                display: inline-block;
                font-weight: 600;
                font-size: 1.35em;
                line-height: 1;
                vertical-align: baseline;
            }

            .home-overlay-link:hover {
                transform: translateX(-4px);
            }

            .special-link {
                display: inline-flex;
                align-items: center;
                position: relative;
                color: var(--special-link-color);
                font-weight: 600;
                text-decoration: none;
                overflow: hidden;
            }

            .special-link:hover {
                color: var(--special-link-color);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 4px;
            }
        </style>
    </head>
    <body class={isPostsPage ? "post-page" : undefined}>
        {showSocialHeader && (
            <header class={isPostsPage ? "posts-header posts-header--social" : "home-header"}>
                {isPostsPage && (
                    <a
                        id="home-link"
                        class="home-overlay-link"
                        href="/"
                        aria-label="Home"
                    >
                        <span class="arrow">←posts</span>
                    </a>
                )}
                <nav class="home-social" aria-label="Social links">
                    <a
                        class="social-icon"
                        href="/andy-yao-resume.pdf"
                        target="_blank"
                        rel="noopener"
                        aria-label="Resume"
                    >
                        <span aria-hidden="true">&#128196;</span>
                        <span class="sr-only">Resume</span>
                    </a>
                    <a
                        class="social-icon"
                        href="https://www.linkedin.com/in/andy-yao-cs"
                        target="_blank"
                        rel="noopener"
                        aria-label="LinkedIn"
                    >
                        <img
                            class="social-icon-img"
                            src="/images/about/linkedin.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <span class="sr-only">LinkedIn</span>
                    </a>
                    <a
                        class="social-icon"
                        href="https://github.com/YetSquire"
                        target="_blank"
                        rel="noopener"
                        aria-label="GitHub"
                    >
                        <img
                            class="social-icon-img"
                            src="/images/about/github.png"
                            alt=""
                            aria-hidden="true"
                        />
                        <span class="sr-only">GitHub</span>
                    </a>
                </nav>
            </header>
        )}
        {isPostsPage && !showSocialHeader && (
            <header class="posts-header">
                <a
                    id="home-link"
                    class="home-overlay-link"
                    href="/"
                    aria-label="Home"
                >
                    <span class="arrow">←posts</span>
                </a>
            </header>
        )}
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; Imitation is the sincerest form of flattery. Copy as you see fit. </p>
        </footer>

        <script>
            // Ensure links open in a new tab by default, even with client-side routing.
            const setLinkTargets = () => {
                document.querySelectorAll("a[href]").forEach((link) => {
                    if (link.getAttribute("target")) return;
                    const href = link.getAttribute("href") || "";
                    if (href.startsWith("/post/")) {
                        link.setAttribute("target", "_self");
                        return;
                    }
                    link.setAttribute("target", "_blank");
                    const rel = link.getAttribute("rel") || "";
                    if (!/\bnoopener\b/.test(rel)) {
                        link.setAttribute("rel", `${rel} noopener`.trim());
                    }
                });
            };

            document.addEventListener("DOMContentLoaded", setLinkTargets);
            document.addEventListener("astro:page-load", setLinkTargets);
        </script>
    </body>
</html>
