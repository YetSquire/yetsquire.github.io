---
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	    <head>
	        <meta charset="utf-8" />
	        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	        <meta name="viewport" content="width=device-width" />
	        <link rel="preconnect" href="https://fonts.googleapis.com" />
	        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	        <link
	            href="https://fonts.googleapis.com/css2?family=Antic&display=swap"
	            rel="stylesheet"
	        />
	        <title>{title}</title>
	        <ClientRouter />
	        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                background-color: #ffffff;
                color: #000000;
            }

            body {
                font-family:
                    "Antic",
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                line-height: 1.6;
                color: #000000;
                background-color: #ffffff;
            }

            button,
            input,
            textarea,
            select {
                font: inherit;
            }

            main {
                max-width: 800px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }
            



            footer {
                margin-top: 4rem;
                padding: 2rem 1rem;
                background-color: #ffffff;
                text-align: center;
                color: #666666;
                font-size: 0.9rem;
                border-top: 1px solid #e5e7eb;
                font-family: "Antic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                            "Helvetica Neue", Arial, sans-serif !important;
            }

            footer p {
                font-family: "Antic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                            "Helvetica Neue", Arial, sans-serif !important;
            }

            a {
                color: #1a73e8;
                text-decoration: none;
                transition: color 0.2s;
            }

            a:hover {
                color: #1557b0;
            }

            .home-overlay {
                position: fixed;
                top: 4px;
                left: 20px;
                z-index: 1000;
            }

            .home-overlay-link {
                display: inline-flex;
                align-items: center;
                color: rgb(0, 0, 0);
                text-decoration: none;
                font-weight: 600;
                font-size: 3rem;
                line-height: 1;
                -webkit-backdrop-filter: blur(8px);
                backdrop-filter: blur(8px);
            }

            .home-overlay-link:hover {
                color: rgb(0, 0, 0);
            }

            .arrow {
                display: inline-block;
                transition: transform 0.3s;
            }

            .home-overlay-link:hover .arrow {
                transform: translateX(-4px);
            }

            .special-link {
                display: inline-flex;
                align-items: center;
                position: relative;
                color: var(--special-link-color);
                font-weight: 600;
                text-decoration: none;
                overflow: hidden;
            }

            .special-link:hover {
                color: var(--special-link-color);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 4px;
            }
        </style>
    </head>
    <body>
        <div class="home-overlay">
            <a
                id="home-link"
                class="home-overlay-link"
                href="/"
                aria-label="Home"
            >
                <span class="arrow">←</span>
            </a>
        </div>
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; Imitation is the sincerest form of flattery. Copy as you see fit. </p>
        </footer>

    </body>
</html>
