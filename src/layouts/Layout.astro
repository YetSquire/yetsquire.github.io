---
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
}

const { title } = Astro.props;

const isPostsPage = Astro.url.pathname.startsWith('/post/');
---

<html lang="en">
	    <head>
	        <meta charset="utf-8" />
	        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	        <meta name="viewport" content="width=device-width" />
	        <link rel="preconnect" href="https://fonts.googleapis.com" />
	        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

            <link rel="preload" href="https://fonts.gstatic.com/s/merriweather/v30/u-440qyriQwlOrhSvowK_l521wRpX-BI.woff2" as="font" type="font/woff2" crossorigin>

	        <link
	            href="https://fonts.googleapis.com/css2?family=Antic&display=swap"
	            rel="stylesheet"
	        />
	        <title>{title}</title>
	        <ClientRouter />
	        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                color-scheme: light;
                --bg: #ffffff;
                --text: #000000;
                --muted: #666666;
                --link: #1a73e8;
                --link-hover: #1557b0;
                --border: #e5e7eb;
                --panel: #ffffff;
            }

            html[data-theme="dark"] {
                color-scheme: dark;
                --bg: #0b0d10;
                --text: #e6e8eb;
                --muted: #b5bac3;
                --link: #8ab4f8;
                --link-hover: #a7c5ff;
                --border: #2a2f36;
                --panel: #11151a;
            }

            html {
                background-color: var(--bg);
                color: var(--text);
            }

            body {
                font-family:
                    "Antic",
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                line-height: 1.6;
                color: var(--text);
                background-color: var(--bg);
            }

            button,
            input,
            textarea,
            select {
                font: inherit;
            }

            main {
                max-width: 800px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }

            footer {
                margin-top: 4rem;
                padding: 2rem 1rem;
                background-color: var(--bg);
                text-align: center;
                color: var(--muted);
                font-size: 0.9rem;
                border-top: 1px solid var(--border);
                font-family: "Antic" !important;
            }

            footer p {
                font-family: "Antic" !important;
            }

            a {
                color: var(--link);
                text-decoration: none;
                transition: color 0.2s;
            }

            a:hover {
                color: var(--link-hover);
            }

            .posts-header {
                position: static;
                padding: 0.5rem 1rem;
            }

            .home-overlay-link {
                display: inline-flex;
                align-items: baseline;
                color: rgb(0, 0, 0);
                text-decoration: none;
                line-height: 1;
                font-size: 1.5rem;
                -webkit-backdrop-filter: blur(8px);
                backdrop-filter: blur(8px);
                transition: transform 0.3s;
                gap: 0.4rem;
            }

            .home-overlay-link:hover {
                color: rgb(0, 0, 0);
            }

            .arrow {
                display: inline-block;
                font-weight: 600;
                font-size: 1.35em;
                line-height: 1;
                vertical-align: baseline;
            }

            .home-overlay-link:hover {
                transform: translateX(-4px);
            }

            .special-link {
                display: inline-flex;
                align-items: center;
                position: relative;
                color: var(--special-link-color);
                font-weight: 600;
                text-decoration: none;
                overflow: hidden;
            }

            .special-link:hover {
                color: var(--special-link-color);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 4px;
            }

            .theme-toggle {
                position: fixed;
                top: 0.5rem;
                right: 1rem;
                z-index: 50;
                padding: 0.35rem 0.8rem;
                border-radius: 999px;
                border: 1px solid var(--border);
                background: var(--panel);
                color: var(--text);
                font-family: "Antic", sans-serif;
                font-size: 0.9rem;
                cursor: pointer;
                transition:
                    transform 0.2s ease,
                    border-color 0.2s ease,
                    background 0.2s ease;
            }

            .theme-toggle:hover,
            .theme-toggle:focus-visible {
                transform: translateY(-2px);
                border-color: var(--link);
                outline: none;
            }
        </style>
    </head>
    <body>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
            Dark
        </button>
        {isPostsPage && (
            <header class="posts-header">
                <a
                    id="home-link"
                    class="home-overlay-link"
                    href="/"
                    aria-label="Home"
                >
                    <span class="arrow">←posts</span>
                </a>
            </header>
        )}
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; Imitation is the sincerest form of flattery. Copy as you see fit. </p>
        </footer>

        <script is:inline>
            (function () {
                const storageKey = "theme";
                const root = document.documentElement;
                const btn = document.getElementById("theme-toggle");
                if (!btn) return;

                const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                const saved = localStorage.getItem(storageKey);
                const initial = saved || (prefersDark ? "dark" : "light");
                root.dataset.theme = initial;
                btn.textContent = initial === "dark" ? "Light" : "Dark";

                btn.addEventListener("click", () => {
                    const next = root.dataset.theme === "dark" ? "light" : "dark";
                    root.dataset.theme = next;
                    localStorage.setItem(storageKey, next);
                    btn.textContent = next === "dark" ? "Light" : "Dark";
                });
            })();
        </script>
    </body>
</html>
