---
import { ClientRouter } from "astro:transitions";
import { TEXT_COLORS } from "../config/site";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ClientRouter />
        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                background-color: #0d1117;
                color: #c9d1d9;
            }

            body {
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                line-height: 1.6;
                color: #c9d1d9;
                background-color: #0d1117;
            }

            nav {
                position: sticky;
                top: 0;
                z-index: 1000;

                background-color: #161b22;
                padding: 1rem 0;
                border-bottom: 1px solid #30363d;

                transition:
                    transform 0.25s ease,
                    opacity 0.25s ease;
            }

            nav.nav-hidden {
                transform: translateY(-100%);
                opacity: 0;
                pointer-events: none;
            }

            nav ul {
                justify-content: center;
                text-align: center;
                list-style: none;
                display: flex;
                gap: 4rem;
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 1rem;
            }

            nav a {
                color: var(--special-link-color);
                text-decoration: none;
                font-weight: 500;
                transition: color 0.2s;
            }

            nav a:hover,
            nav a.active {
            }

            main {
                max-width: 1200px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }

            footer {
                margin-top: 4rem;
                padding: 2rem 1rem;
                background-color: #161b22;
                text-align: center;
                color: #8b949e;
                font-size: 0.9rem;
                border-top: 1px solid #30363d;
            }

            a {
                color: #58a6ff;
                text-decoration: none;
                transition: color 0.2s;
            }

            a:hover {
                color: #79c0ff;
            }

            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                color: #f0f6fc;
            }

            .special-link {
                display: inline-flex;
                align-items: center;
                position: relative;
                color: var(--special-link-color);
                font-weight: 600;
                text-decoration: none;
                overflow: hidden;
            }

            .special-link::before {
                content: "";
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(
                    90deg,
                    transparent,
                    rgba(88, 166, 255, 0.3),
                    transparent
                );
                transition: left 0.5s ease-in-out;
            }

            .special-link:hover::before {
                left: 100%;
            }

            .special-link:hover {
                color: var(--special-link-color);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 4px;
            }
        </style>
    </head>
    <body>
        <nav>
            <ul>
                <li>
                    <a
                        href="/"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.Home};`}
                        >Home</a
                    >
                </li>
                <li>
                    <a
                        href="/posts?tags=blog"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.Blog};`}
                        >Blog</a
                    >
                </li>
                <li>
                    <a
                        href="/posts?tags=project"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.Project};`}
                        >Project</a
                    >
                </li>
                <li>
                    <a
                        href="/about"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.About};`}
                        >About</a
                    >
                </li>
            </ul>
        </nav>
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; I'm not a lawyer. Nothing here is copyrighted.</p>
        </footer>
    </body>
</html>

