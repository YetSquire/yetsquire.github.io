---
import { ClientRouter } from "astro:transitions";
import { TEXT_COLORS } from "../config/site";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	    <head>
	        <meta charset="utf-8" />
	        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	        <meta name="viewport" content="width=device-width" />
	        <meta name="generator" content={Astro.generator} />
	        <link rel="preconnect" href="https://fonts.googleapis.com" />
	        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	        <link
	            href="https://fonts.googleapis.com/css2?family=Antic&display=swap"
	            rel="stylesheet"
	        />
	        <title>{title}</title>
	        <ClientRouter />
	        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                background-color: #ffffff;
                color: #000000;
            }

	            body {
	                font-family:
	                    "Antic",
	                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
	                    "Helvetica Neue", Arial, sans-serif;
	                line-height: 1.6;
	                color: #000000;
	                background-color: #ffffff;
	            }

            nav {
                position: sticky;
                top: 0;
                z-index: 1000;

                background-color: rgb(0, 0, 0);
                padding: 1rem 0;
                border-bottom: 1px solid #e5e7eb;

                transition:
                    transform 0.25s ease,
                    opacity 0.25s ease;
            }

            nav.nav-hidden {
                transform: translateY(-100%);
                opacity: 0;
                pointer-events: none;
            }

            nav ul {
                justify-content: center;
                text-align: center;
                list-style: none;
                display: flex;
                gap: 4rem;
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 1rem;
            }

            nav a {
                color: var(--special-link-color);
                text-decoration: none;
                font-weight: 500;
                transition: color 0.2s;
            }

            nav a:hover,
            nav a.active {
            }

            main {
                max-width: 1200px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }

            footer {
                margin-top: 4rem;
                padding: 2rem 1rem;
                background-color: #ffffff;
                text-align: center;
                color: #666666;
                font-size: 0.9rem;
                border-top: 1px solid #e5e7eb;
            }

            a {
                color: #1a73e8;
                text-decoration: none;
                transition: color 0.2s;
            }

            a:hover {
                color: #1557b0;
            }

            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                color: #000000;
            }

            .special-link {
                display: inline-flex;
                align-items: center;
                position: relative;
                color: var(--special-link-color);
                font-weight: 600;
                text-decoration: none;
                overflow: hidden;
            }

            .special-link:hover {
                color: var(--special-link-color);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 4px;
            }
        </style>
    </head>
    <body>
        <nav>
            <ul>
                <li>
                    <a
                        href="/"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.Home};`}
                        >Home</a
                    >
                </li>
                <li>
                    <a
                        href="/posts?tags=Blog"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.Blog};`}
                        >Thoughts</a
                    >
                </li>
                <li>
                    <a
                        href="/posts?tags=Project"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.Project};`}
                        >Projects</a
                    >
                </li>
                <li>
                    <a
                        href="/about"
                        class="special-link"
                        style={`--special-link-color: ${TEXT_COLORS.About};`}
                        >About</a
                    >
                </li>
            </ul>
        </nav>
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; Imitation is the sincerest form of flattery. Copy as you see fit. </p>
        </footer>
    </body>
</html>

