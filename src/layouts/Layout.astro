---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
				line-height: 1.6;
				color: #333;
			}

			nav {
				background-color: #f5f5f5;
				padding: 1rem 0;
				border-bottom: 1px solid #ddd;
			}

			nav ul {
				list-style: none;
				display: flex;
				gap: 2rem;
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 1rem;
			}

			nav a {
				text-decoration: none;
				color: #333;
				font-weight: 500;
				transition: color 0.2s;
			}

			nav a:hover,
			nav a.active {
				color: #0066cc;
			}

			main {
				max-width: 1200px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}

			footer {
				margin-top: 4rem;
				padding: 2rem 1rem;
				background-color: #f5f5f5;
				text-align: center;
				color: #666;
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<nav>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/posts">Posts</a></li>
				<li><a href="/about">About</a></li>
			</ul>
		</nav>
		<main>
			<slot />
		</main>
		<footer>
			<p>&copy; 2025 My Blog. All rights reserved.</p>
		</footer>
	</body>
</html>
