---
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	    <head>
	        <meta charset="utf-8" />
	        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	        <meta name="viewport" content="width=device-width" />
	        <meta name="generator" content={Astro.generator} />
	        <link rel="preconnect" href="https://fonts.googleapis.com" />
	        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	        <link
	            href="https://fonts.googleapis.com/css2?family=Antic&display=swap"
	            rel="stylesheet"
	        />
	        <title>{title}</title>
	        <ClientRouter />
	        <style is:global>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                background-color: #ffffff;
                color: #000000;
            }

            body {
                font-family:
                    "Antic",
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                line-height: 1.6;
                color: #000000;
                background-color: #ffffff;
            }

            button,
            input,
            textarea,
            select {
                font: inherit;
            }

            main {
                max-width: 800px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }
            



            footer {
                margin-top: 4rem;
                padding: 2rem 1rem;
                background-color: #ffffff;
                text-align: center;
                color: #666666;
                font-size: 0.9rem;
                border-top: 1px solid #e5e7eb;
                font-family: "Antic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                            "Helvetica Neue", Arial, sans-serif !important;
            }

            footer p {
                font-family: "Antic", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                            "Helvetica Neue", Arial, sans-serif !important;
            }

            a {
                color: #1a73e8;
                text-decoration: none;
                transition: color 0.2s;
            }

            a:hover {
                color: #1557b0;
            }

            .home-overlay {
                position: fixed;
                top: 4px;
                left: 20px;
                z-index: 1000;
            }

            .home-overlay-link {
                display: inline-flex;
                align-items: center;
                color: rgb(0, 0, 0);
                text-decoration: none;
                font-weight: 600;
                font-size: 3rem;
                line-height: 1;
                -webkit-backdrop-filter: blur(8px);
                backdrop-filter: blur(8px);
            }

            .home-overlay-link:hover {
                color: rgb(0, 0, 0);
            }

            .home-overlay-link.is-disabled {
                opacity: 0.5;
                pointer-events: none;
            }

            .arrow {
                display: inline-block;
                transition: transform 0.3s;
            }

            .home-overlay-link:hover .arrow {
                transform: translateX(-4px);
            }

            .special-link {
                display: inline-flex;
                align-items: center;
                position: relative;
                color: var(--special-link-color);
                font-weight: 600;
                text-decoration: none;
                overflow: hidden;
            }

            .special-link:hover {
                color: var(--special-link-color);
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: 4px;
            }
        </style>
    </head>
    <body>
        <div class="home-overlay">
            <a
                id="back-link"
                class="home-overlay-link"
                href="/"
                aria-label="Back"
            >
                <span class="arrow">←</span>
            </a>
        </div>
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; Imitation is the sincerest form of flattery. Copy as you see fit. </p>
        </footer>

        <script is:inline>
            (() => {
                if (typeof window === "undefined") return;

                const STACK_KEY = "blog:lastPages";
                const MAX_STACK = 50;

                const getCurrentUrl = () =>
                    `${window.location.pathname}${window.location.search}${window.location.hash}`;

                const readStack = () => {
                    try {
                        const raw = window.sessionStorage.getItem(STACK_KEY);
                        const parsed = raw ? JSON.parse(raw) : [];
                        return Array.isArray(parsed)
                            ? parsed.filter((v) => typeof v === "string")
                            : [];
                    } catch {
                        return [];
                    }
                };

                const writeStack = (stack) => {
                    try {
                        window.sessionStorage.setItem(
                            STACK_KEY,
                            JSON.stringify(stack.slice(-MAX_STACK)),
                        );
                    } catch {
                        // ignore
                    }
                };

                const updateBackLink = () => {
                    const link = document.getElementById("back-link");
                    if (!link) return;

                    const current = getCurrentUrl();
                    const stack = readStack();
                    if (stack[stack.length - 1] !== current) stack.push(current);
                    writeStack(stack);

                    const backTarget = stack.length >= 2 ? stack[stack.length - 2] : "/";
                    link.href = backTarget;
                    link.classList.toggle("is-disabled", stack.length < 2);

                    if (link.dataset.backInit === "1") return;
                    link.dataset.backInit = "1";

                    link.addEventListener("click", (e) => {
                        const target = link.getAttribute("href") || "/";
                        if (!target || target === current) return;

                        e.preventDefault();
                        const nextStack = readStack();
                        if (nextStack[nextStack.length - 1] === current) {
                            nextStack.pop();
                            writeStack(nextStack);
                        }
                        window.location.assign(target);
                    });
                };

                document.addEventListener("astro:page-load", updateBackLink);
                document.addEventListener("DOMContentLoaded", updateBackLink);
                updateBackLink();
            })();
        </script>
    </body>
</html>
