{
  "manifest_version": 3,
  "name": "Docs Astro Compiler",
  "version": "0.1",
  "description": "Compile Google Docs tabs into Astro blog posts",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "http://localhost:3001/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}